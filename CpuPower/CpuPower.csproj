<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cpupower</ToolCommandName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DeviceTool.CpuPower</PackageId>
    <Title>DeviceTool.CpuPower</Title>
    <Description>Measure cpu power tool.</Description>
    <PackageTags>tools hardware</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
    <PackageReference Include="Usa.Smart.CommandLine.Hosting" Version="3.1.0" />
  </ItemGroup>

</Project>
